<div class="simple-benefits">
	<div class="page-width">
		<h2 class="simple-benefits__main-title">Защо да изберете нас?</h2>

		<div class="simple-benefits__grid">
			{% for block in section.blocks %}
				<div class="simple-benefits__item" {{ block.shopify_attributes }}>
					<div class="simple-benefits__icon">{{ block.settings.icon }}</div>
					<h3 class="simple-benefits__title">{{ block.settings.title }}</h3>
					<p class="simple-benefits__text">{{ block.settings.text }}</p>
				</div>
			{% endfor %}
		</div>
	</div>
</div>

<style>
	.simple-benefits {
		padding: 60px 0;
		background-color: #ffffff;
	}
	.simple-benefits__main-title {
		text-align: center;
		font-size: 2.5rem;
		margin-bottom: 40px;
		color: #121212;
	}
	.simple-benefits__grid {
		display: flex;
		gap: 30px;
		justify-content: space-between;
	}
	.simple-benefits__item {
		flex: 1;
		text-align: center;
		padding: 20px;
		background: #f7f7f7;
		border-radius: 8px;
	}
	.simple-benefits__icon {
		font-size: 3rem;
		margin-bottom: 15px;
	}
	.simple-benefits__title {
		font-size: 1.5rem;
		margin: 10px 0;
		color: #121212;
	}
	.simple-benefits__text {
		font-size: 1rem;
		color: #555555;
		line-height: 1.5;
	}

	/* Адаптивност за телефони */
	@media screen and (max-width: 749px) {
		.simple-benefits__grid {
			flex-direction: column;
			gap: 20px;
		}
	}
</style>

{% schema %}
{
	"name": "Simple Benefits",
	"tag": "section",
	"class": "section2",
	"blocks": [
		{
			"type": "benefit_column",
			"name": "Колона с предимство",
			"settings": [
				{
					"type": "text",
					"id": "icon",
					"default": "🚀",
					"label": "Икона (Емоджи)"
				},
				{
					"type": "inline_richtext",
					"id": "title",
					"default": "Бърза доставка",
					"label": "Заглавие"
				},
				{
					"type": "textarea",
					"id": "text",
					"default": "Изпращаме всяка поръчка в рамките на 24 часа.",
					"label": "Текст"
				}
			]
		}
	],
	"presets": [
        {
            "name": "Simple Benefits Blocks",
            "blocks": [
                { "type": "benefit_column" },
                { "type": "benefit_column" },
                { "type": "benefit_column" }
            ]
        }
    ]
}
{% endschema %}
