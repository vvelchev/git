<div class="section-featured-cards">
  <div class="shell">
    <div class="section__inner">
      <div
        class="section__head"
      >
        {% if section.settings.heading %}
          <h1>{{ section.settings.heading }}</h1>
        {% endif %}
        {% if section.settings.content %}
          <p>{{ section.settings.content }}</p>
        {% endif %}
      </div>
      <!-- /.section__head -->

      <div class="section__body">
        <div
          class="grid-alt"
          data-layout="{{ section.settings.card_layout }}"
          data-mobile-slider="{{ section.settings.grid_slider_mobile }}"
          data-slides-desktop="{{ section.settings.count_desktop }}"
          data-slides-mobile="{{ section.settings.count_mobile }}"
        >
          <div class="swiper">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                <div class="swiper-slide">
                  <div class="card" {{ block.shopify_attributes }}>
                    {% if block.settings.image %}
                      <div class="card__image">
                        {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                      </div>
                    {% else %}
                      <div class="card__image card__image--placeholder">
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {% endif %}

                    <div class="card__content">
                      {% if block.settings.subheading %}
                        <h6>{{ block.settings.subheading }}</h6>
                      {% endif %}
                      {% if block.settings.heading %}
                        <h3>{{ block.settings.heading }}</h3>
                      {% endif %}
                      {% if block.settings.text %}{{ block.settings.text }}{% endif %}

                      {% if block.settings.button_link %}
                        <a
                          {% if block.settings.button_link != blank -%}
                            href="{{ block.settings.button_link }}"
                          {%- else -%}
                            role="link" aria-disabled="true"
                          {%- endif %}
                          class="button"
                        >
                          {{ block.settings.button_label }}
                        </a>
                      {% endif %}
                    </div>
                    <!-- /.card__content -->
                  </div>
                </div>
                <!-- /.swiper-slide -->
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .section-featured-cards {
    padding: 40px 0;
    .shell {
      max-width: 1600px;
      margin: 0 auto;
      padding: 0 var(--page-margin);
    }

    .section__head {
      --text-align: {{ section.settings.text_align }};
        text-align: {{ section.settings.text_align }};
        margin-bottom: 40px;
    }

    .section__body {
    }

    .grid-alt {
     --grid-cols: {{section.settings.count_desktop}};
     {% if  section.settings.count_mobile %}
       @media (max-width: 767px) {
        --grid-cols: {{  section.settings.count_mobile}};
      {% endif %}
      }

    }

    .grid-alt[data-layout="grid"] {
      .swiper, .swiper-wrapper {
        display:contents;
      }
    }
    .grid-alt[data-layout="slider"] {
      display: contents;
    }
    .grid-alt[data-mobile-slider="true"] {
      @media (max-width: 767px) {
        & {
          display: contents;
        }
        .swiper, .swiper-wrapper {
          display:flex;
        }
      }
    }
  }

  .card {
    --text-align: {{ section.settings.card_text_align }};
    text-align: {{ section.settings.card_text_align }};
    .card__image {
      position: relative;
      aspect-ratio: {{section.settings.media_asp}};
      margin-bottom: 20px;
      border-radius: 10px;
      overflow:hidden;

      img,svg {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        object-fit:cover;
      }
    }
    .card__content {
      all: revert;

      h6,h3,p{
        margin: 0 0 15px;
      }

      .button {
        display:inline-flex;
      }
    }
  }
</style>

{% schema %}
{
  "name": "Featured cards",
  "tag": "section",
  "class": "section-featured-cards",
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "content",
      "label": "Content",
      "default": "Lorem ipsum, dolor sit amet consectetur adipisicing elit. "
    },
    {
      "type": "paragraph",
      "content": "Title Settings"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "select",
      "id": "media_asp",
      "label": "Media Aspect Ratio",
      "options": [
        { "value": "9/16", "label": "Portrait" },
        { "value": "16/9", "label": "Landscape" },
        { "value": "1", "label": "Square" }
      ],
      "default": "16/9"
    },
    {
      "type": "select",
      "id": "card_text_align",
      "label": "Text align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Cards List "
    },
    {
      "type": "select",
      "id": "card_layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "count_desktop",
      "label": "Count per row - desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "count_mobile",
      "label": "Count per row - mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "grid_slider_mobile",
      "label": "Enable mobile slider",
      "default": false,
      "visible_if": "{{ section.settings.card_layout == 'grid' }}"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Subheading" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>In fermentum et sollicitudin ac. Eleifend mi in nulla posuere. Venenatis Cras sed felis eget velit aliquet sagittis id consectetur.</p>"
        },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Featured cards",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.grid-alt').forEach((gridEl) => {
      const layout = gridEl.dataset.layout;
      const mobileSliderEnabled = gridEl.dataset.mobileSlider === 'true';
      const slidesDesktop = parseInt(gridEl.dataset.slidesDesktop, 10) || 4;
      const slidesMobile = parseInt(gridEl.dataset.slidesMobile, 10) || 2;
      const swiperEl = gridEl.querySelector('.swiper');
      let instance = null;

      function shouldBeSlider() {
        if (layout === 'slider') return true;
        if (layout === 'grid' && mobileSliderEnabled && window.matchMedia('(max-width: 767px)').matches) return true;
        return false;
      }

      function init() {
        if (instance) return;
        instance = new Swiper(swiperEl, {
          slidesPerView: slidesMobile,
          spaceBetween: 16,
          breakpoints: {
            768: { slidesPerView: slidesDesktop },
          },
        });
        gridEl.classList.add('is-swiper-active');
      }

      function destroy() {
        if (!instance) return;
        instance.destroy(true, true);
        instance = null;
        gridEl.classList.remove('is-swiper-active');
      }

      function update() {
        shouldBeSlider() ? init() : destroy();
      }

      update();
      window.addEventListener('resize', update);
    });
  });
</script>
