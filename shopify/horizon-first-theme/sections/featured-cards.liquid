{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<div class="section-featured-cards">
  <div class="shell">
    <div class="section__inner">
      {% if section.settings.heading != blank or section.settings.content != blank %}
        <div
          class="section__head"
          style="--text-align: {{ section.settings.text_align }}"
        >
          {% if section.settings.heading != blank %}
            <h3 class="h2">{{ section.settings.heading | escape }}</h3>
          {% endif %}
          {% if section.settings.content != blank %}
            <p>{{ section.settings.content }}</p>
          {% endif %}
        </div>
        <!-- /.section__head -->
      {% endif %}
      {% if section.blocks.size > 0 %}
        <div class="section__body">
          <div
            class="grid-alt"
            style="
              --grid-cols: {{ section.settings.count_desktop }};
              {%- if section.settings.count_mobile %}--grid-cols-mobile: {{ section.settings.count_mobile }};{% endif -%}
            "
            data-layout="{{ section.settings.card_layout }}"
            data-mobile-slider="{{ section.settings.grid_slider_mobile }}"
          >
            <slider-cards
              class="swiper"
              data-slides-desktop="{{ section.settings.count_desktop }}"
              data-slides-mobile="{{ section.settings.count_mobile }}"
            >
              <div class="swiper-wrapper">
                {% for block in section.blocks %}
                  <div class="swiper-slide">
                    <div
                      class="card"
                      {{ block.shopify_attributes }}
                      style="
                        --aspect-ratio: {{ section.settings.media_asp }};
                        --card-text-align: {{ section.settings.card_text_align }}
                      "
                    >
                      <div class="card__image {% if block.settings.image == blank %} card__image--placeholder{% endif %}">
                        {% if block.settings.image != blank %}
                          {{
                            block.settings.image
                            | image_url: width: 800
                            | image_tag: loading: 'lazy', alt: block.settings.heading | escape
                          }}
                        {% else %}
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        {% endif %}
                      </div>
                      <div class="card__content">
                        {% if block.settings.subheading != blank %}
                          <h6>{{ block.settings.subheading | escape }}</h6>
                        {% endif %}
                        {% if block.settings.heading != blank %}
                          <h4>{{ block.settings.heading | escape }}</h4>
                        {% endif %}
                        {% if block.settings.text != blank %}
                          <div class="card__entry">
                            {{ block.settings.text }}
                          </div>
                          <!-- /.card__entry -->
                        {% endif %}
                        {% if block.settings.button_link != blank %}
                          <a
                            {% if block.settings.button_link != blank -%}
                              href="{{ block.settings.button_link }}"
                            {%- else -%}
                              role="link" aria-disabled="true"
                            {%- endif %}
                            class="button"
                          >
                            {{- block.settings.button_label | escape -}}
                          </a>
                        {% endif %}
                      </div>
                      <!-- /.card__content -->
                    </div>
                  </div>
                  <!-- /.swiper-slide -->
                {% endfor %}
              </div>
            </slider-cards>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% stylesheet %}
  .section-featured-cards {
    padding: 40px 0;
    .shell {
      max-width: 1600px;
      margin: 0 auto;
      padding: 0 var(--page-margin);
    }

    .section__head {
      text-align: var(--text-align);
      margin-bottom: 40px;
    }

    .grid-alt {
      --grid-gutter-x: 2rem;
    }

    .grid-alt[data-layout='grid'] {
      gap: var(--grid-gutter-x);

      .swiper,
      .swiper-wrapper {
        display: contents;
      }
    }
    .grid-alt[data-layout='slider'] {
      display: contents;

      slider-cards {
        display: block;
      }
    }
    .grid-alt[data-mobile-slider='true'] {
      @media (max-width: 767px) {
        & {
          display: contents;
        }
        .swiper,
        .swiper-wrapper {
          display: flex;
        }
      }
    }
  }

  .card {
    text-align: var(--card-text-align);
    .card__image {
      position: relative;
      aspect-ratio: var(--aspect-ratio);
      margin-bottom: 20px;
      border-radius: 10px;
      overflow: hidden;

      img,
      svg {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
    .card__content {
      all: revert;

      h6,
      h3,
      p {
        margin: 0 0 15px;
      }

      .button {
        display: inline-flex;
      }
    }
  }
{% endstylesheet %}

<script>
  (() => {
    if (customElements.get('slider-cards')) {
      return;
    }

    class SliderCards extends HTMLElement {
      constructor() {
        super();
        this.instance = null;
        this.handleResize = this.update.bind(this);
      }

      connectedCallback() {
        if (typeof Swiper === 'undefined') {
          document.addEventListener('DOMContentLoaded', () => this.connectedCallback(), { once: true });
          return;
        }

        this.gridEl = this.closest('.grid-alt');
        this.layout = this.gridEl?.dataset.layout;
        this.mobileSliderEnabled = this.gridEl?.dataset.mobileSlider === 'true';
        this.slidesDesktop = parseInt(this.dataset.slidesDesktop, 10) || 4;
        this.slidesMobile = parseInt(this.dataset.slidesMobile, 10) || 2;
        this.mediaQuery = window.matchMedia('(max-width: 767px)');

        this.update();
        this.mediaQuery.addEventListener('change', this.handleResize);
        window.addEventListener('resize', this.handleResize);
      }

      disconnectedCallback() {
        this.mediaQuery?.removeEventListener('change', this.handleResize);
        window.removeEventListener('resize', this.handleResize);
        this.destroy();
      }

      shouldBeSlider() {
        if (this.layout === 'slider') return true;
        if (this.layout === 'grid' && this.mobileSliderEnabled && this.mediaQuery.matches) return true;
        return false;
      }

      getGutter() {
        const raw = getComputedStyle(this.gridEl || this)
          .getPropertyValue('--grid-gutter-x')
          .trim();
        if (!raw) return 16;

        // rem -> px conversion, otherwise parse as-is (px, unitless, etc.)
        if (raw.endsWith('rem')) {
          const rootFontSize = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
          return parseFloat(raw) * rootFontSize;
        }

        return parseFloat(raw) || 16;
      }

      init() {
        if (this.instance) return;
        this.instance = new Swiper(this, {
          slidesPerView: this.slidesMobile,
          spaceBetween: this.getGutter(),
          breakpoints: {
            768: { slidesPerView: this.slidesDesktop },
          },
        });
        this.gridEl?.classList.add('is-swiper-active');
      }

      destroy() {
        if (!this.instance) return;
        this.instance.destroy(true, true);
        this.instance = null;
        this.gridEl?.classList.remove('is-swiper-active');
      }

      update() {
        this.shouldBeSlider() ? this.init() : this.destroy();
      }
    }

    customElements.define('slider-cards', SliderCards);
  })();
</script>

{% schema %}
{
  "name": "Featured cards",
  "tag": "section",
  "class": "section-featured-cards",
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "content",
      "label": "Content",
      "default": "Lorem ipsum, dolor sit amet consectetur adipisicing elit. "
    },
    {
      "type": "paragraph",
      "content": "Title Settings"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "select",
      "id": "media_asp",
      "label": "Media Aspect Ratio",
      "options": [
        { "value": "9/16", "label": "Portrait" },
        { "value": "16/9", "label": "Landscape" },
        { "value": "1", "label": "Square" }
      ],
      "default": "16/9"
    },
    {
      "type": "select",
      "id": "card_text_align",
      "label": "Text align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Cards List "
    },
    {
      "type": "select",
      "id": "card_layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "count_desktop",
      "label": "Count per row - desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "count_mobile",
      "label": "Count per row - mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "grid_slider_mobile",
      "label": "Enable mobile slider",
      "default": false,
      "visible_if": "{{ section.settings.card_layout == 'grid' }}"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Subheading" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>In fermentum et sollicitudin ac. Eleifend mi in nulla posuere. Venenatis Cras sed felis eget velit aliquet sagittis id consectetur.</p>"
        },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Featured cards",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
