{%- capture header_class -%}
  header-base
  {%- if section.settings.sticky_header %} header-base--sticky {%- endif -%}
  {%- if template == "index" and section.settings.transparent_home  %} header-base--transparent {%- endif -%}
{%- endcapture -%}
<header
  class="{{header_class}}"
  style="--padding-top: {{ section.settings.spacing_top }}px; --padding-bottom: {{ section.settings.spacing_bottom }}px; --gap: {{ section.settings.gap }}px"
>
  <div class="shell">
    <div class="header__inner">
      {% content_for 'blocks' %}

      {%- if section.settings.enable_country and localization.available_countries.size > 1 -%}
        {%- form 'localization', class: 'country-selector' -%}
          <label for="country-{{ section.id }}" class="visually-hidden">{{ 'header_base.country' | t }}</label>
          <select
            id="country-{{ section.id }}"
            class="country-selector__select"
            name="country_code"
            onchange="this.form.submit()"
          >
            {%- for country in localization.available_countries -%}
              <option
                value="{{ country.iso_code }}"
                {% if country.iso_code == localization.country.iso_code %}
                  selected
                {% endif %}
              >
                {{ country.currency.symbol }}
              </option>
            {%- endfor -%}
          </select>
          <noscript
            ><button type="submit">{{ 'header_base.update' | t }}</button></noscript
          >
        {%- endform -%}
      {%- endif -%}

      {%- if section.settings.enable_language and localization.available_languages.size > 1 -%}
        {%- form 'localization', class: 'header-selector header-selector--language' -%}
          <label for="language-{{ section.id }}" class="visually-hidden">{{ 'header_base.language' | t }}</label>
          <select
            id="language-{{ section.id }}"
            name="language_code"
            class="header-selector__select"
            onchange="this.form.submit()"
          >
            {%- for language in localization.available_languages -%}
              <option
                value="{{ language.iso_code }}"
                lang="{{ language.iso_code }}"
                {% if language.iso_code == localization.language.iso_code %}
                  selected
                {% endif %}
              >
                {{ language.endonym_name | capitalize }}
              </option>
            {%- endfor -%}
          </select>
          <noscript
            ><button type="submit" class="header-selector__submit">{{ 'header_base.update' | t }}</button></noscript
          >
        {%- endform -%}
      {%- endif -%}
    </div>
    <!-- /.header__inner -->
  </div>
  <!-- /.shell -->
</header>
<!-- /.header-base -->
{% stylesheet %}
  .header-base {
    position: relative;
    z-index: 13;
    padding: var(--padding-top) 0 var(--padding-bottom);
    background-color: white;

    &.header-base--transparent {
      background-color: transparent;
    }

    & .header__inner {
      display: flex;
      align-items: center;
      gap: var(--gap);

      /* & .logo,
      & .nav-base {
        order: -1;
      } */
    }
  }

  #header-group:has(.header-base--sticky) {
    position: sticky;
    top: 0;
    z-index: 13;
  }

  .country-selector {
    position: relative;
    display: inline-flex;
    align-items: center;

    &::after {
      content: '';
      position: absolute;
      right: 12px;
      top: 50%;
      width: 6px;
      height: 6px;
      border-right: 1.5px solid currentColor;
      border-bottom: 1.5px solid currentColor;
      translate: 0 -75%;
      rotate: 45deg;
      pointer-events: none;
    }
  }

  .country-selector__select {
    appearance: none;
    -webkit-appearance: none;
    padding: 6px 25px 6px 12px;
    border: 1px solid rgb(0 0 0 / 0.15);
    border-radius: 999px;
    background-color: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color 0.2s;

    &:hover {
      border-color: currentColor;
    }

    &:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 2px;
    }

    /* падащият списък — системният на браузъра, само цветовете */
    & option {
      color: #000;
      background-color: #fff;
    }
  }

  .country-selector__submit {
    margin-left: 8px;
    padding: 6px 12px;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .header-selector--language .header-selector__select {
    border-color: transparent;
    padding-left: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .header-selector--language .header-selector__select:hover {
    border-color: transparent;
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:header_base.name",
  "tag": "div",
  "class": "header-base-wrapper",
  "settings": [
    { "type": "header", "content": "t:header_base.content.general_settings" },
    { "type": "checkbox", "id": "sticky_header", "label": "t:header_base.settings.sticky_header.label", "default": true },
    { "type": "checkbox", "id": "transparent_home", "label": "t:header_base.settings.transparent_home.label", "default": false },
    {
      "type": "range",
      "id": "spacing_top",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "t:header_base.settings.spacing_top.label",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "t:header_base.settings.spacing_bottom.label",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "t:header_base.settings.gap.label",
      "default": 20
    },
    { "type": "checkbox", "id": "show_border", "label": "t:header_base.settings.show_border.label", "default": false },
    { "type": "header", "content": "t:header_base.content.selectors" },
    { "type": "checkbox", "id": "enable_country", "label": "t:header_base.settings.enable_country.label", "default": false },
    { "type": "checkbox", "id": "enable_language", "label": "t:header_base.settings.enable_language.label", "default": false }
  ],
  "max_blocks": 8,
  "blocks": [
    { "type": "_logo-base" },
    { "type": "_nav-base" },
    { "type": "_search-base" },
    { "type": "_btn-cart-base" },
    { "type": "account-base" },
    { "type": "button" },
    { "type": "_spacer-base" }
  ],
  "presets": [
    {
      "name": "t:header_base.presets.name",
      "category": "t:header_base.presets.category",
      "blocks": [
        { "type": "_logo-base" },
        { "type": "_nav-base" },
        { "type": "_search-base" },
        { "type": "_btn-cart-base" },
        { "type": "button" },
        { "type": "account-base" }
      ]
    }
  ]
}
{% endschema %}
