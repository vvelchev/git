<div class="simple-hero" style="background-image: url('{{ section.settings.image | image_url: width: 1800 }}');">
	<div class="simple-hero__overlay">
		<div class="page-width">
			<h1 class="simple-hero__title">
				{{ section.settings.title }}
			</h1>
		</div>
	</div>
</div>

<style>
	.simple-hero {
		position: relative;
		min-height: 500px;
		/* Височина на секцията */
		background-position: center;
		background-size: cover;
		background-repeat: no-repeat;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* Тъмен слой над снимката, за да се чете текста по-лесно */
	.simple-hero__overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.4);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.simple-hero__title {
		color: #ffffff;
		font-size: 3.5rem;
		text-align: center;
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	/* Адаптивност за мобилни устройства */
	@media screen and (max-width: 749px) {
		.simple-hero {
			min-height: 350px;
		}

		.simple-hero__title {
			font-size: 2.2rem;
		}
	}
</style>

{% schema %}
{
"name": "Simple Hero",
"tag": "section",
"class": "section",
"settings": [
{
"type": "image_picker",
"id": "image",
"label": "Фоново изображение"
},
{
"type": "inline_richtext",
"id": "title",
"default": "Заглавие на вашата кампания",
"label": "Заглавие (H1)"
}
],
"presets": [
{
"name": "Simple Hero"
}
]
}
{% endschema %}