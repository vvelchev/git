{%- comment -%} Настройките на бутона и количката са в Theme settings → Cart Base (config/settings_schema.json) {%- endcomment -%}
<button
  type="button"
  class="btn-cart-base btn-cart-base--{{ settings.cart_base_count_style }}"
  popovertarget="cart-base"
  aria-label="{{ 'cart_base.open' | t }}"
  {{ block.shopify_attributes }}
>
  {{ 'icon-cart.svg' | inline_asset_content }}

  <span data-cart-count>
    {%- if cart.item_count > 0 %}{{ cart.item_count }}{% endif -%}
  </span>
</button>
<!-- /.btn-cart-base -->

{% schema %}
{
  "name": "t:btn_cart_base.name",
  "tag": null,
  "settings": [
    { "type": "header", "content": "t:btn_cart_base.content.general_settings" },
    {
      "type": "paragraph",
      "content": "t:btn_cart_base.content.cart_settings_title_drawer"
    }
  ],
  "presets": [
    {
      "name": "t:btn_cart_base.presets.name"
    }
  ]
}
{% endschema %}
