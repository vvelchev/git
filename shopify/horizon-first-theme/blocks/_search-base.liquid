{%- liquid
  assign style = block.settings.style
  assign placeholder = block.settings.placeholder
  if placeholder == blank
    assign placeholder = 'header_base.search.placeholder' | t
  endif
-%}

{%- capture search_icon -%}
  <svg xmlns="http://www.w3.org/2000/svg" xml:space="preserve" viewBox="0 0 122.879 119.799" aria-hidden="true" focusable="false">
    <path d="M49.988 0h.016v.007C63.803.011 76.298 5.608 85.34 14.652c9.027 9.031 14.619 21.515 14.628 35.303h.007v.073h-.007a49.9 49.9 0 0 1-3.471 18.301v.007a50 50 0 0 1-5.547 10.307l29.082 26.139.018.016.157.146.011.011a8.6 8.6 0 0 1 2.649 5.78 8.6 8.6 0 0 1-1.979 5.971l-.011.016-.175.203-.035.035-.146.16-.016.021a8.6 8.6 0 0 1-5.78 2.646 8.6 8.6 0 0 1-5.971-1.978l-.015-.011-.204-.175-.029-.024-29.745-26.734q-1.322.93-2.687 1.765a50 50 0 0 1-3.813 2.115c-6.699 3.342-14.269 5.222-22.272 5.222v.007h-.016v-.007c-13.799-.004-26.296-5.601-35.338-14.645C5.605 76.291.016 63.805.007 50.021H0v-.049h.007c.004-13.799 5.601-26.296 14.645-35.338C23.683 5.608 36.167.016 49.955.007V0zm.016 11.21v.007h-.049v-.007c-10.686.007-20.372 4.35-27.384 11.359-7.011 7.009-11.358 16.705-11.361 27.404h.007v.049h-.007c.007 10.686 4.347 20.367 11.359 27.381 7.009 7.012 16.705 11.359 27.403 11.361v-.007h.049v.007c10.686-.007 20.368-4.348 27.382-11.359 7.011-7.009 11.358-16.702 11.36-27.4h-.006v-.049h.006c-.006-10.686-4.35-20.372-11.358-27.384S60.703 11.213 50.004 11.21"/>
  </svg>
{%- endcapture -%}

{%- capture search_form -%}
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-base__form">
    <input
      type="search"
      name="q"
      placeholder="{{ placeholder | escape }}"
      aria-label="{{ 'header_base.search.input_label' | t }}"
    >
    <button type="submit" class="search-base__submit" aria-label="{{ 'header_base.search.input_label' | t }}">
      {{ search_icon }}
    </button>
  </form>
{%- endcapture -%}

<div
  class="search-base search-base--{{ style }}{% unless block.settings.show_on_mobile %} search-base--hide-mobile{% endunless %}"
  {{ block.shopify_attributes }}
>
  {%- if style == 'inline' -%}
    {{ search_form }}
  {%- else -%}
    <button
      type="button"
      popovertarget="search-{{ block.id }}"
      aria-label="{{ 'header_base.search.open' | t }}"
      class="search-btn"
    >
      {{ search_icon }}
    </button>

    {%- comment -%} popup = център + fade, drawer = панел, който слиза отгоре {%- endcomment -%}
    <div class="popup-search popup-search--{{ style }}" id="search-{{ block.id }}" popover>
      <div class="shell">
        <div class="popup__inner">
          {{ search_form }}
        </div>
        <!-- /.popup__inner -->
      </div>
      <!-- /.shell -->
    </div>
  {%- endif -%}
</div>
<!-- /.search-base -->

{{ 'search-base.css' | asset_url | stylesheet_tag: preload: true }}

{% schema %}
{
  "name": "t:search.name",
  "tag": null,
  "settings": [
    { "type": "header", "content": "t:search.content.general_settings" },
    {
      "type": "select",
      "id": "style",
      "label": "t:search.settings.style.label",
      "options": [
        { "value": "popup", "label": "t:search.settings.style.options.popup" },
        { "value": "drawer", "label": "t:search.settings.style.options.drawer" },
        { "value": "inline", "label": "t:search.settings.style.options.inline" }
      ],
      "default": "popup"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:search.settings.placeholder.label",
      "info": "t:search.settings.placeholder.info"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "t:search.settings.show_on_mobile.label",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:search.name"
    }
  ]
}
{% endschema %}
