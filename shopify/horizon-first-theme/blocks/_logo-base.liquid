<div class="logo-wrapper-{{ block.id }}" {{ block.shopify_attributes }}>
  <a
    href="{{ shop.url }}"
    class="logo"
    {% if block.settings.logo_desktop == blank and block.settings.logo_mobile == blank %}
      aria-label="{{ block.settings.logo_alt_text | default: shop.name }}"
    {% endif %}
  >
    <picture>
      {% if block.settings.logo_mobile != blank %}
        {% assign mobile_width_2x = block.settings.logo_mobile_width | times: 2 %}
        <source
          media="(max-width: 767px)"
          srcset="
            {{ block.settings.logo_mobile | image_url: width: block.settings.logo_mobile_width }} 1x,
            {{ block.settings.logo_mobile | image_url: width: mobile_width_2x }} 2x
          "
        >
      {% endif %}

      {% if block.settings.logo_desktop != blank %}
        {% assign desktop_width_2x = block.settings.logo_desktop_width | times: 2 %}
        <img
          src="{{ block.settings.logo_desktop | image_url: width: block.settings.logo_desktop_width }}"
          srcset="
            {{ block.settings.logo_desktop | image_url: width: block.settings.logo_desktop_width }} 1x,
            {{ block.settings.logo_desktop | image_url: width: desktop_width_2x }} 2x
          "
          alt="{{ block.settings.logo_alt_text | default: shop.name }}"
          width="{{ block.settings.logo_desktop_width }}"
          height="{{ block.settings.logo_desktop_width | divided_by: block.settings.logo_desktop.aspect_ratio }}"
          loading="eager"
        >
      {% else %}
        <span class="logo-text">{{ shop.name }}</span>
      {% endif %}
    </picture>
  </a>
</div>

{% style %}
  .logo-wrapper-{{ block.id }} {
    --logo-max-width-desktop: {{ block.settings.logo_desktop_width }}px;
    --logo-max-width-mobile: {{ block.settings.logo_mobile_width }}px;
    font-size: 0;
    width: var(--logo-max-width-desktop);

    @media (max-width: 767px) {
      width: var(--logo-max-width-mobile);
    }

    a {
      display: block;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:logo.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_desktop",
      "label": "t:logo.settings.logo_desktop.label"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "t:logo.settings.logo_mobile.label"
    },
    {
      "type": "range",
      "id": "logo_desktop_width",
      "min": 50,
      "max": 150,
      "step": 1,
      "unit": "px",
      "label": "t:logo.settings.logo_desktop_width.label",
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_mobile_width",
      "min": 50,
      "max": 150,
      "step": 1,
      "unit": "px",
      "label": "t:logo.settings.logo_mobile_width.label",
      "default": 60
    },
    {
      "type": "text",
      "id": "logo_alt_text",
      "label": "t:logo.settings.logo_alt_text.label"
    }
  ],
  "presets": [
    {
      "name": "t:logo.presets.name"
    }
  ]
}
{% endschema %}
