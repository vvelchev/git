{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}

{% if block_settings.label != blank or block_settings.icon != blank %}
  <a
    {% if link == blank %}
      role="link"
      aria-disabled="true"
    {% else %}
      href="{{ link }}"
    {% endif %}
    class="
      size-style
      {{ block_settings.style_class }}
      {{ block_settings.style_outline }}
      {{ block_settings.style_class }}--{{ block.id }}
    "
    style="{% render 'size-style', settings: block_settings %}"
    {%- if block_settings.open_in_new_tab -%}
      target="_blank"
      rel="noopener noreferrer"
    {%- endif -%}
    {{ block.shopify_attributes }}
  >
    {% if block_settings.icon %}
      <i
        class="mask-img"
        style="
          --url:url('{{ block_settings.icon | image_url: width: 32 }}');
          {% if block_settings.icon_position == "end" %} order:99; }{% endif %}
        "
      ></i>
    {% endif %}
    {{ block_settings.label }}
  </a>
{% endif %}
